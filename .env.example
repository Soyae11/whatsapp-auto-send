# Copy to .env and fill in. `docker compose` reads it, and so does `npm run dev`
# (via DATABASE_URL etc. exported in your shell or an env loader).

# Bearer token for every route except /health. Generate with: openssl rand -hex 32
API_KEY=change-me-to-at-least-16-characters

# Only needed when running on the host; compose builds its own.
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
PORT=3000
LOG_LEVEL=info

# Outbound webhooks (message.received, message.status, session.status_changed).
# Leave WEBHOOK_URL empty to disable; when set, WEBHOOK_SECRET is required.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=5000

# compose only
POSTGRES_PASSWORD=gateway
GATEWAY_PORT=3000
POSTGRES_PORT=5432
