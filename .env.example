# The whole stack's configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#   sed -i "s|^GATEWAY_DISPATCHER_KEY=.*|GATEWAY_DISPATCHER_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^GATEWAY_CONSOLE_KEY=.*|GATEWAY_CONSOLE_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^DISPATCHER_ADMIN_KEY=.*|DISPATCHER_ADMIN_KEY=$(openssl rand -hex 32)|" .env
#   sed -i "s|^WA_GATEWAY_WEBHOOK_SECRET=.*|WA_GATEWAY_WEBHOOK_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^POSTGRES_SUPERUSER_PASSWORD=.*|POSTGRES_SUPERUSER_PASSWORD=$(openssl rand -hex 16)|" .env
#
# Every shared secret is defined once here. They used to be copied between
# baileys/.env and dispatcher/.env by hand, where they could silently drift apart and
# produce a 401 that looked like a bug in the gateway.

# ── Shared secrets ────────────────────────────────────────────────────────────────────
# The gateway has two bearer tokens, and they must be different values. baileys scopes what
# each one may do, so neither client can be revoked or compromised into the other's job:
#
#   GATEWAY_DISPATCHER_KEY  send + read     — dispatcher only. Cannot pair, restart or log out.
#   GATEWAY_CONSOLE_KEY     read + manage   — wa-console only. CANNOT SEND.
#
# The console's inability to send is the point: a send that skips dispatcher also skips the
# pacing that keeps the number from being banned. Unset GATEWAY_CONSOLE_KEY to revoke
# console access outright; the send path is unaffected.
GATEWAY_DISPATCHER_KEY=change-me-to-at-least-16-characters
GATEWAY_CONSOLE_KEY=change-me-to-a-different-at-least-16-characters

# Operator/admin token for dispatcher's /internal routes. wa-console sends this as
# WA_DISPATCHER_ADMIN_KEY — keep the two in step.
DISPATCHER_ADMIN_KEY=change-me-to-a-different-32-byte-secret

# Signs the delivery receipts baileys posts to dispatcher. Both sides need the same value
# or messages send fine and never progress past `sent`.
WA_GATEWAY_WEBHOOK_SECRET=change-me-to-at-least-16-characters

# ── Database ──────────────────────────────────────────────────────────────────────────
# One Postgres server, one database per service. These are only applied when the pgdata
# volume is first created; changing them later requires ALTER ROLE or a fresh volume.
POSTGRES_SUPERUSER_PASSWORD=change-me
BAILEYS_DB_PASSWORD=baileys
DISPATCHER_DB_PASSWORD=dispatcher
CONSOLE_DB_PASSWORD=console

# ── Sessions and senders ──────────────────────────────────────────────────────────────
# The worker refuses to boot with WA_SESSIONS empty: a worker with no runners looks
# healthy while its queues fill up behind it.
# Each entry is name:session_id[:priority][:dry-run]. The name is what senders() and every
# send request use — never the baileys session id or a phone number.
WA_SESSIONS=
WA_SENDERS=hr-notifications:my-session
WA_DRY_RUN=false
# WA_SESSIONS must list the session ids used by WA_SENDERS above, e.g.:
#   WA_SESSIONS=<baileys-session-id-1>,<baileys-session-id-2>
#   WA_SENDERS=team-a:<baileys-session-id-1>,team-b:<baileys-session-id-2>

# A sender's main/backup session pool (wa-console's Pools page) is separate from the static
# mapping above and lives in Postgres — no restart needed to reconfigure. This only tunes how
# backed-up a pool's main has to be, estimated, before load spreading shares new sends across
# its backups. Failover on an actual send failure is immediate regardless of this value.
WA_POOL_BUSY_DELAY=60s

# ── Ports on the host ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=3000       # baileys HTTP API
DISPATCHER_PORT=8080    # dispatcher API and /docs
ASYNQMON_PORT=8081      # queue UI
POSTGRES_PORT=5433      # shared Postgres — wa-console and the integration tests use this
REDIS_PORT=6380         # shared Redis (6379 is taken on this machine)

# ── Everything else ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
WEBHOOK_TIMEOUT_MS=5000
WA_VERSION=dev

# Browser origins allowed to call dispatcher directly — e.g. dispatcher-playground served with
# `python3 -m http.server 5500`. Empty means no Access-Control-* headers at all, which is
# the default; wa-console doesn't need this, it calls dispatcher from the Laravel backend,
# not from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5500

# Dispatcher tuning (slots, coalescing, circuit breaker) is left at its defaults. To
# override, add the variable here and to the `x-dispatcher-env` block in
# docker-compose.yml — see dispatcher/internal/config/config.go for the full list.
