# For running this service on the host — `npm run dev`, `npm run migrate`, and the
# integration tests. The container does NOT read this file: it is configured from the
# stack's ../.env via ../docker-compose.yml, so shared secrets are defined once.
#
# Copy to .env and fill in. Every variable here is required; the service refuses to boot
# without them rather than starting in a half-configured state.
#
# DATABASE_URL points at the shared Postgres published by the root stack on 5433.

DATABASE_URL=postgres://baileys:baileys@localhost:5433/baileys
PORT=3000
LOG_LEVEL=info

# Two bearer tokens, scoped, and they must not be the same value.
#
#   DISPATCHER_API_KEY  send + read     — what the Go API and worker send. Required.
#   CONSOLE_API_KEY     read + manage   — wa-console's session lifecycle. Optional; leaving
#                                         it unset revokes console access without touching
#                                         the send path.
#
# The console key deliberately cannot send: a send that skips the dispatcher also skips the
# pacing that keeps the number from being banned.
# Generate each with: openssl rand -hex 32
DISPATCHER_API_KEY=change-me-to-at-least-16-characters
CONSOLE_API_KEY=change-me-to-a-different-at-least-16-characters

# Outbound webhooks. Leave WEBHOOK_URL unset and nothing is dispatched; set it and
# WEBHOOK_SECRET becomes required, because an unsigned webhook cannot be trusted.
# Events: message.received, message.status, session.status_changed. The QR is never sent —
# it is live pairing material.
# WEBHOOK_URL=http://go-api:8080/internal/whatsapp/events
# WEBHOOK_SECRET=change-me-to-at-least-16-characters
# Short on purpose: a slow consumer must never hold up message handling.
# WEBHOOK_TIMEOUT_MS=5000
