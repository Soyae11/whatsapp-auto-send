{
  "name": "baileys-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=\"${DATABASE_URL:-postgres://baileys:baileys@localhost:5433/baileys}\" vitest run",
    "verify:restart": "DATABASE_URL=\"${DATABASE_URL:-postgres://baileys:baileys@localhost:5433/baileys}\" tsx scripts/verify-auth-restart.ts",
    "pair": "DATABASE_URL=\"${DATABASE_URL:-postgres://baileys:baileys@localhost:5433/baileys}\" tsx scripts/pair-once.ts"
  },
  "dependencies": {
    "@hapi/boom": "9.1.4",
    "baileys": "7.0.0-rc14",
    "fastify": "5.11.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/qrcode-terminal": "0.12.2",
    "pino-pretty": "13.1.3",
    "qrcode-terminal": "0.12.0",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
