# For running this app on the host — `composer run dev`, `php artisan migrate`, `php artisan
# test`. Copy to .env and fill in. Every DB_*/BAILEYS_* value here mirrors a secret already
# defined once in the root .env (see ../.env.example) — this app has no secrets of its own.

APP_NAME="wa-console"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shared Postgres from the root stack (../docker-compose.yml), published on ${POSTGRES_PORT}.
# Only the `console` database, owned by the `console` role — the same per-service isolation
# baileys and dispatcher get, so this app can't reach their tables either.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=console
DB_USERNAME=console
DB_PASSWORD=change-me   # ${CONSOLE_DB_PASSWORD} in the root .env

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# baileys' console-scoped credential: read + manage, deliberately never send — a send that
# skipped the dispatcher would also skip the pacing that keeps a number from being banned.
# ${GATEWAY_PORT} / ${GATEWAY_CONSOLE_KEY} in the root .env. Generate with: openssl rand -hex 32
BAILEYS_BASE_URL=http://127.0.0.1:3000
BAILEYS_CONSOLE_KEY=change-me-to-at-least-16-characters

# wa-laravel (wa/laravel) — the send-message page. WA_URL is wa-consumer-api's ${DISPATCHER_PORT}.
# WA_KEY is minted with `go-consumer/wa-consumer-api` `make create-key NAME=wa-console
# PROJECT=internal SENDERS=<sender-a>,<sender-b>` — scoped only to the senders this console
# should be able to use, never a raw session id.
WA_URL=http://127.0.0.1:8080
WA_KEY=change-me-to-a-key-from-make-create-key
# wa-laravel defaults to dry-run outside APP_ENV=production. This console's only job is to
# send, so that default is overridden here on purpose — set to true to go back to dry-run.
WA_DRY_RUN=false

# Pools page (main/backup session rotation) — an operator action, not a send, so it uses
# wa-consumer-api's admin credential rather than the sending-scoped WA_KEY above.
# ${DISPATCHER_PORT} / ${DISPATCHER_ADMIN_KEY} in the root .env.
WA_ADMIN_URL=http://127.0.0.1:8080
WA_ADMIN_KEY=change-me-to-a-different-32-byte-secret
